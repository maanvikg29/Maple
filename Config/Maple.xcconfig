// Maple.xcconfig — the iPhone app target.

PRODUCT_NAME = Maple
PRODUCT_BUNDLE_IDENTIFIER = $(MAPLE_BUNDLE_ID)
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Entitlements follow the signing tier: Maple-free or Maple-paid.
CODE_SIGN_ENTITLEMENTS = Config/Entitlements/Maple-$(MAPLE_TIER).entitlements

// Info.plist: generated keys below, merged with Config/Maple-Info.plist for keys Xcode can't generate.
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Maple-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Maple
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.healthcare-fitness
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIUserInterfaceStyle = Dark
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_NSHealthShareUsageDescription = Maple reads your sleep, heart rate and mindful minutes to award leaves and show your trends. This data stays on your iPhone.
INFOPLIST_KEY_NSHealthUpdateUsageDescription = Maple can save your wind-down sessions to Health as mindful minutes.

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// Swift 6 concurrency: UI code is main-actor by default.
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES

ENABLE_PREVIEWS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
